{
  "name": "dicekeys",
  "author": "DiceKeys, LLC",
  "productName": "DiceKeys",
  "description": "DiceKeys App",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "main": "electron-js/electron.js",
  "homepage": "https://dicekeys.com",
  "scripts": {
    "postinstall": "node ./node_modules/electron-builder/cli.js install-app-deps",
    "watch": "rimraf ./electron-js && tsc --watch",
    "build": "rimraf ./electron-js tsconfig.tsbuildinfo && tsc",
    "start-electron": "electron .",
    "start": "rimraf ./electron-js tsconfig.tsbuildinfo && tsc && electron --version && node ../scripts/run-npm.mjs --prefix . run start-electron",
    "lint": "eslint --ext .ts .",
    "pack": "node ../scripts/package-unsigned.mjs",
    "pack:unsigned": "node ../scripts/package-unsigned.mjs"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "config": {
    "forge": "./forge.config.js"
  },
  "build": "electron-builder.unsigned.js",
  "devDependencies": {
    "@electron/notarize": "2.3.0",
    "@electron/osx-sign": "1.1.0",
    "@types/w3c-web-hid": "1.0.6",
    "@typescript-eslint/eslint-plugin": "7.5.0",
    "@typescript-eslint/parser": "7.5.0",
    "electron": "29.1.6",
    "electron-builder": "24.13.3",
    "electron-builder-squirrel-windows": "25.0.0-alpha.5",
    "electron-reloader": "1.2.3",
    "eslint": "8.57.0",
    "eslint-plugin-import": "2.29.1",
    "rimraf": "5.0.5",
    "typescript": "5.4.3"
  },
  "dependencies": {
    "keytar": "7.9.0"
  }
}
